{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:got-it-learning:schema:curriculum-shard-v3",
  "title": "学会啦课程内容分片 V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "knowledge", "units"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "packageId": { "type": "string", "minLength": 1 },
    "knowledge": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "domain", "objectives", "prerequisites", "misconceptions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "$ref": "#/$defs/localized" },
          "domain": { "type": "string", "minLength": 1 },
          "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "misconceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "lessons"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "$ref": "#/$defs/localized" },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "order", "title", "description", "learningGoal", "demo", "legacyAliases", "knowledgeIds", "prerequisiteKnowledgeIds", "commonMistakes", "hints", "reviewPolicy", "reviewStage", "items"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "order": { "type": "integer", "minimum": 1 },
                "title": { "$ref": "#/$defs/localized" },
                "description": { "$ref": "#/$defs/localized" },
                "learningGoal": { "$ref": "#/$defs/localized" },
                "demo": { "$ref": "#/$defs/demo" },
                "legacyAliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                "knowledgeIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                "prerequisiteKnowledgeIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                "commonMistakes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "hints": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["level", "kind", "text"],
                    "properties": {
                      "level": { "type": "integer", "minimum": 1, "maximum": 3 },
                      "kind": { "enum": ["direction", "steps", "example"] },
                      "text": { "$ref": "#/$defs/localized" }
                    }
                  }
                },
                "reviewPolicy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["masteryThreshold", "intervalDays"],
                  "properties": {
                    "masteryThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
                    "intervalDays": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true }
                  }
                },
                "reviewStage": { "$ref": "#/$defs/reviewStage" },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "type", "question", "assessmentRole", "variantGroup", "difficulty", "explanation", "knowledgeId", "source", "review"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "type": { "enum": ["single_choice", "multiple_choice", "boolean", "number", "text", "fill_blank", "short_response", "ordering", "matching", "reading"] },
                      "question": { "$ref": "#/$defs/localized" },
                      "assessmentRole": { "enum": ["recognition", "application", "misconception", "transfer"] },
                      "variantGroup": { "type": "string", "minLength": 1 },
                      "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
                      "explanation": { "$ref": "#/$defs/localized" },
                      "knowledgeId": { "type": "string", "minLength": 1 },
                      "source": {
                        "type": "object",
                        "required": ["providerItemId", "origin", "licenseId"],
                        "properties": {
                          "providerItemId": { "type": "string", "minLength": 1 },
                          "origin": { "type": "string", "minLength": 1 },
                          "licenseId": { "type": "string", "minLength": 1 }
                        }
                      },
                      "review": {
                        "type": "object",
                        "required": ["status", "structureChecked", "answerChecked", "contentReviewed"],
                        "properties": {
                          "status": { "$ref": "#/$defs/reviewStage" },
                          "structureChecked": { "type": "boolean" },
                          "answerChecked": { "type": "boolean" },
                          "contentReviewed": { "type": "boolean" },
                          "reviewer": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "reviewStage": {
      "enum": ["draft", "structure-checked", "answer-checked", "content-reviewed", "releasable"]
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMinutes", "concept", "steps", "example", "takeaway", "commonMistake"],
      "properties": {
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 10 },
        "concept": { "$ref": "#/$defs/localized" },
        "steps": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/$defs/localized" } },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt", "steps", "answer"],
          "properties": {
            "prompt": { "$ref": "#/$defs/localized" },
            "steps": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/localized" } },
            "answer": { "$ref": "#/$defs/localized" }
          }
        },
        "takeaway": { "$ref": "#/$defs/localized" },
        "commonMistake": { "$ref": "#/$defs/localized" }
      }
    }
  }
}
