{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:got-it-learning:schema:course-package-v2",
  "title": "学会啦 Course Package",
  "type": "object",
  "required": ["schemaVersion", "subject", "levels"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "subject": { "enum": ["math", "english", "science"] },
    "provider": {
      "type": "object",
      "required": ["id", "name", "license"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/level" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["zh", "en"],
          "properties": {
            "zh": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "level": {
      "type": "object",
      "required": ["id", "name", "questions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "curriculum": { "$ref": "#/$defs/localizedText" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      },
      "additionalProperties": true
    },
    "baseQuestion": {
      "type": "object",
      "required": ["id", "type", "question", "knowledge"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["single_choice", "multi_select", "boolean", "number", "text", "fill_blank", "short_answer", "ordering", "matching", "reading"]
        },
        "question": { "$ref": "#/$defs/localizedText" },
        "knowledge": { "$ref": "#/$defs/localizedText" },
        "passage": { "$ref": "#/$defs/localizedText" },
        "explanation": { "$ref": "#/$defs/localizedText" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "source": {
          "type": "object",
          "required": ["providerItemId"],
          "properties": {
            "providerItemId": { "type": "string", "minLength": 1 },
            "attribution": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "question": {
      "allOf": [
        { "$ref": "#/$defs/baseQuestion" },
        {
          "type": "object",
          "properties": {
            "options": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/localizedText" }
            },
            "answer": {},
            "answers": { "type": "array", "items": { "type": ["string", "number"] } },
            "tolerance": { "type": "number", "minimum": 0 },
            "caseSensitive": { "type": "boolean" },
            "ignoreWhitespace": { "type": "boolean" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } },
            "pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["left", "right"],
                "properties": {
                  "left": { "$ref": "#/$defs/localizedText" },
                  "right": { "$ref": "#/$defs/localizedText" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
